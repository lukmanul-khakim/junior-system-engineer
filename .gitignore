# Environment secrets
.env

# TLS private keys and generated certificates
docker/nginx/certs/**/*.key
docker/nginx/certs/**/*.csr
docker/nginx/certs/**/*.p12
docker/nginx/certs/server.crt
docker/nginx/certs/mtls/client.crt

# Private TLS key dan generated certs
docker/nginx/certs/*.key
docker/nginx/certs/*.crt

# Ansible generated files
*.retry

# Python artifacts
__pycache__/
*.py[cod]
.venv/

# OS/editor files
.DS_Store
Thumbs.db
.vscode/
.idea/

# Allow public mTLS CA certificate
!docker/nginx/certs/mtls/ca.crt
